# PCONXT application settings represented by pconxt-deployment.yaml.
# Sensitive values are loaded from files under the ignored secrets/ directory.
PCONXT_HTTP_ADDR=:8080
PCONXT_CONSOLE_LOG_LEVEL=info
PCONXT_POSTGRES_LOG_LEVEL=warn
PCONXT_ENV=production
PCONXT_POSTGRES_DSN=postgres://user:password@postgres.example.com:5432/pconxt?sslmode=disable
PCONXT_POWER_METRICS_URL=https://power.example.com/powermetrics
PCONXT_POWER_METRICS_POLL_INTERVAL=60s
PCONXT_POWER_METRICS_STALE_AFTER=2m
PCONXT_TESLA_VEHICLE_SEED_JSON=[{"name":"myTesla","displayName":"My Tesla","vin":"5YJ3E1EAXKF000000"}]
PCONXT_VENSTAR_THERMOSTAT_SEED_JSON=[{"name":"upstairs","endpointURL":"http://192.168.1.10","lowerComfortBoundF":72,"upperComfortBoundF":76,"expectedCoolingDrawWatts":3200}]
PCONXT_VENSTAR_TRUSTED_CIDRS=["192.168.1.10/32"]
PCONXT_THERMOSTAT_COOLING_SIGMOID_T=0.25
PCONXT_THERMOSTAT_COOLING_SIGMOID_K=1
PCONXT_VEHICLE_CHARGING_SIGMOID_T=1
PCONXT_VEHICLE_CHARGING_SIGMOID_K=1
PCONXT_MQTT_HOST=mqtt.example.com
PCONXT_MQTT_PORT=1883
PCONXT_MQTT_CLIENT_ID=PCONXT-TeslaBLE-1
PCONXT_FORECAST_SLEEP_ENABLED=true
PCONXT_FORECAST_SLEEP_BASE_URL=http://forecast.example.com:8980
PCONXT_FORECAST_SLEEP_AM_IRRADIANCE_THRESHOLD=800
PCONXT_FORECAST_SLEEP_PM_IRRADIANCE_THRESHOLD=800
PCONXT_TIME_ZONE=America/Denver
